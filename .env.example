# Example environment file for scratchagent.

# OpenAI API Key (required for most examples)
OPENAI_BASE_URL=
OPENAI_API_KEY=

# embedding 模型 和  GPT-4o 多模态模型
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=

# embedding 模型（走 OpenRouter，OpenAI 的 embedding 当前地域受限，建议用 perplexity）
EMBEDDING_MODEL=perplexity/pplx-embed-v1-0.6b

TAVILY_API_KEY=

HF_TOKEN=

E2B_API_KEY=